# Copy to .env and fill in real credentials to talk to a model. Without a key,
# the API still boots and the eval harness (test/) still runs — only POST
# /chat fails, with a clear 503, rather than a silent wrong answer (see
# openai/openai.service.ts).
#
# Any OpenAI-compatible chat-completions endpoint works — this project only
# uses the standard chat.completions.create + tools + response_format
# surface, nothing OpenAI-specific. Three examples:
#
#   Real OpenAI:      OPENAI_BASE_URL=https://api.openai.com/v1
#                      OPENAI_MODEL=gpt-4.1-mini
#
#   Local Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1
#                      OPENAI_MODEL=llama3.2:latest   (or any pulled, tool-capable model)
#                      OPENAI_API_KEY=ollama            (Ollama ignores the value, but the field can't be empty)
#
#   An OpenAI-compatible proxy (e.g. a hosted router):
#                      OPENAI_BASE_URL=https://<provider>/v1
#                      OPENAI_MODEL=<whatever model id that provider exposes>
#                      OPENAI_API_KEY=<that provider's key>

PORT=4000
CORS_ORIGIN=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Left explicit on purpose — see openai/openai.service.ts's comment on why this
# is never inherited from an ambient OPENAI_BASE_URL in the host environment.
OPENAI_BASE_URL=https://api.openai.com/v1
